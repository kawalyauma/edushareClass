{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist-types",
    "tsBuildInfoFile": "dist-types/.tsbuildinfo",
    "types": [
      "vite/client"
    ],
    "noEmit": false,
    "emitDeclarationOnly": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ],
  "references": [
    {
      "path": "../../packages/shared-types"
    },
    {
      "path": "../../packages/lesson-format"
    },
    {
      "path": "../../packages/pdf-selection"
    },
    {
      "path": "../../packages/stroke-engine"
    },
    {
      "path": "../../packages/math-notation"
    },
    {
      "path": "../../packages/recording-core"
    }
  ]
}
