# Opt-in only. Native local studio keeps working without these variables.
EDUSHARE_CLOUD_ENABLED=0
EDUSHARE_DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/edushareclass
EDUSHARE_PRIVATE_DIR=/srv/edushareclass/private
# Generate a fresh secret: openssl rand -hex 32 (NEVER commit the real value)
EDUSHARE_JWT_SECRET=
EDUSHARE_ALLOW_SIGNUP=0
EDUSHARE_CREATE_SCHEMA=0
EDUSHARE_CORS_ORIGINS=https://your-school-domain.example
